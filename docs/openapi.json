  "info": {
    "description": "API portalu Science Net — artykuły naukowe w formie mediów społecznościowych.",
    "title": "Science Net API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/articles": {
      "get": {
        "description": "Zwraca jedną stronę artykułów; `next_cursor` wskazuje następną.",
        "operationId": "list_articles_api_articles_get",
        "parameters": [
          {
            "description": "Kursor ze strony poprzedniej.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Kursor ze strony poprzedniej.",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "field",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FieldSlug"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Field"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 100,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "author_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Author Id"
            }
          },
          {
            "description": "Rozmiar strony.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "description": "Rozmiar strony.",
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ArticleRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Lista artykułów od najnowszych",
        "tags": [
          "articles"
        ]
      },
      "post": {
        "description": "Publikuje artykuł jako zalogowany użytkownik.",
        "operationId": "create_article_api_articles_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticleCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Publikacja artykułu",
        "tags": [
          "articles"
        ]
      }
    },
