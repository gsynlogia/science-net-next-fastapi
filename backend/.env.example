# Skopiuj do `.env` (`cp .env.example .env`). Plik `.env` nie trafia do repozytorium.
APP_NAME=Science Net API
APP_VERSION=1.0.0
DATABASE_URL=postgresql+psycopg://sciencenet:sciencenet@localhost:5433/sciencenet
TEST_DATABASE_URL=postgresql+psycopg://sciencenet:sciencenet@localhost:5433/sciencenet_test
JWT_SECRET=lokalny-sekret-deweloperski-zmien-na-losowy-0123456789
JWT_EXPIRE_MINUTES=60
